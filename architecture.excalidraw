   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The model reads language. The engine computes dates, quantities and prices. A person approves anything that reaches a customer or production.",
   "autoResize": true,
   "lineHeight": 1.25
  },
