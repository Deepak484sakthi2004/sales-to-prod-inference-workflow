  {
   "id": "api-t",
   "type": "text",
   "x": 422,
   "y": 50,
   "width": 382.2,
   "height": 568.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 194804717,
   "version": 1,
   "versionNonce": 1183364968,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "REST API  (ApiController, CustomerController)\n\nAsk (read by the language model)\n  POST /api/ask\n  GET  /api/trace?q=\n  GET  /api/promise\n  GET  /api/quotations/at-risk\n  GET  /api/self\n  GET  /api/explain?key=\n\nViews and pick-lists\n  GET  /api/views/planner\n  GET  /api/enquiries\n  GET  /api/catalog\n  GET  /api/policy\n  GET  /api/decisions?n=\n\nA person decides\n  GET  /api/actions\n  POST /api/actions/{id}/decision\n  GET  /api/suggestions\n  POST /api/suggestions/{id}/accept\n  POST /api/policy/min-slack\n  POST /api/policy/rules/{id}\n\nOperations and review\n  POST /api/tick\n  POST /api/mailbox/poll\n  POST /api/replan\n  POST /api/status/sync\n  POST /api/sim/mail | slip | feed-lag | progress\n  POST /api/scenarios/run   (plain-text run log)\n\nCustomer (token-scoped)\n  GET  /customer/api/orders",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "api",
   "originalText": "REST API  (ApiController, CustomerController)\n\nAsk (read by the language model)\n  POST /api/ask\n  GET  /api/trace?q=\n  GET  /api/promise\n  GET  /api/quotations/at-risk\n  GET  /api/self\n  GET  /api/explain?key=\n\nViews and pick-lists\n  GET  /api/views/planner\n  GET  /api/enquiries\n  GET  /api/catalog\n  GET  /api/policy\n  GET  /api/decisions?n=\n\nA person decides\n  GET  /api/actions\n  POST /api/actions/{id}/decision\n  GET  /api/suggestions\n  POST /api/suggestions/{id}/accept\n  POST /api/policy/min-slack\n  POST /api/policy/rules/{id}\n\nOperations and review\n  POST /api/tick\n  POST /api/mailbox/poll\n  POST /api/replan\n  POST /api/status/sync\n  POST /api/sim/mail | slip | feed-lag | progress\n  POST /api/scenarios/run   (plain-text run log)\n\nCustomer (token-scoped)\n  GET  /customer/api/orders",
   "autoResize": true,
   "lineHeight": 1.25
  },
