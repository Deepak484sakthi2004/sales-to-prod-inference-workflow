  {
   "id": "legend-t",
   "type": "text",
   "x": 1592,
   "y": 950,
   "width": 713.44,
   "height": 105.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 2132657286,
   "version": 1,
   "versionNonce": 1462945690,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "How to read this\n- Arrows are calls: HTTP between processes, in-process inside core.\n- Violet: language read by the model (mail, questions, CRM notes). The core checks every value.\n- Green: the engine computes every date, quantity, price and probability.\n- Yellow: nothing reaches a customer or production without a recorded person or pre-approved rule.\n- If the model is down: mail waits unread, questions say \"cannot read\", nothing is guessed.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "legend",
   "originalText": "How to read this\n- Arrows are calls: HTTP between processes, in-process inside core.\n- Violet: language read by the model (mail, questions, CRM notes). The core checks every value.\n- Green: the engine computes every date, quantity, price and probability.\n- Yellow: nothing reaches a customer or production without a recorded person or pre-approved rule.\n- If the model is down: mail waits unread, questions say \"cannot read\", nothing is guessed.",
   "autoResize": true,
   "lineHeight": 1.25
  },
