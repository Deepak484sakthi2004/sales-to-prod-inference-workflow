# Copy to .env and fill in. start.sh and docker compose both read it. Never commit .env.

# --- Language model (Gemini, through ai-service/) ---------------------------------------------
# Key from https://aistudio.google.com/apikey . The model reads all mail, questions and CRM notes; without it mail
# waits unread and questions are not understood (promise checks still work from the form).
GEMINI_API_KEY=
# Model ids change; check https://ai.google.dev/gemini-api/docs/models and pin the one you tested.
GEMINI_MODEL=gemini-3.8-flash
# MINIMAL | LOW | MEDIUM | HIGH, or empty for models without thinking levels
GEMINI_THINKING_LEVEL=LOW
# Run without the model:
# AI_ENABLED=false

# --- Where the core keeps its own records ------------------------------------------------------
# memory (default): nothing to install, gone on restart.  mongo: MongoDB Atlas or any MongoDB 5+.
S2P_STORE=memory
# Atlas: Database > Connect > Drivers. Allow your IP under Network Access. Use a database user with readWrite on the db.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=s2p
